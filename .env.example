# Copy to .env.local and fill in values:
#   cp .env.example .env.local
#
# Or pull from Vercel (recommended for matching production):
#   npx vercel link && npx vercel env pull .env.local

# --- Required ---
# Supabase Postgres (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
# POSTGRES_URL=   # alternative to DATABASE_URL

# OpenRouter (LLM)
OPENROUTER_API_KEY=

# Vercel Blob — one of:
#   BLOB_READ_WRITE_TOKEN
#   or BLOB_STORE_ID + VERCEL_OIDC_TOKEN (from vercel env pull)
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=

# Required for client uploads >4.5 MB when BLOB_READ_WRITE_TOKEN is absent
# BLOB_WEBHOOK_PUBLIC_KEY=

# --- Recommended ---
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- API access (team shared secret) ---
# When set, all /api/* routes (except /api/upload/capabilities) require the secret.
# Use the SAME value in both vars so the browser UI can call the API.
# Also enable Vercel Deployment Protection for the outer layer.
EVALUADOR_API_SECRET=
NEXT_PUBLIC_EVALUADOR_API_SECRET=
